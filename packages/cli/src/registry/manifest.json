{
    "python3": {
        "name": "Python 3",
        "default_version": "3.10.13",
        "versions": {
            "3.10.13": {
                "url": "https://github.com/indygreg/python-build-standalone/releases/download/20240107/cpython-3.10.13+20240107-x86_64-unknown-linux-gnu-install_only.tar.gz",
                "sha256": "c40d749904089c2d4b77a23df132a113c02114e67d2eaa953d52b8555385b7fa",
                "extractFolder": "python",
                "compile_cmd": null,
                "run_cmd": ["/opt/python3/bin/python3", "{files}"]
            }
        }
    },
    "nodejs": {
        "name": "Node.js",
        "default_version": "24.16.0",
        "versions": {
            "20.11.0": {
                "url": "https://nodejs.org/dist/v20.11.0/node-v20.11.0-linux-x64.tar.xz",
                "extractFolder": "node-v20.11.0-linux-x64",
                "compile_cmd": null,
                "run_cmd": ["/opt/nodejs/bin/node", "{files}"]
            },
            "24.16.0": {
                "url": "https://nodejs.org/dist/v24.16.0/node-v24.16.0-linux-x64.tar.xz",
                "extractFolder": "node-v24.16.0-linux-x64",
                "compile_cmd": null,
                "run_cmd": ["/opt/nodejs/bin/node", "{files}"]
            }
        }
    },
    "c": {
        "name": "C (GCC)",
        "default_version": "12.0.0",
        "versions": {
            "12.0.0": {
                "url": "system",
                "compile_cmd": ["/usr/bin/gcc", "-O2", "-Wall", "{files}", "-o", "main"],
                "run_cmd": ["./main"]
            }
        }
    },
    "cpp": {
        "name": "C++ (GCC)",
        "default_version": "12.0.0",
        "versions": {
            "12.0.0": {
                "url": "system",
                "compile_cmd": [
                    "/usr/bin/g++",
                    "-O2",
                    "-Wall",
                    "-std=c++20",
                    "{files}",
                    "-o",
                    "main"
                ],
                "run_cmd": ["./main"]
            }
        }
    },
    "go": {
        "name": "Go",
        "default_version": "1.22.1",
        "versions": {
            "1.22.1": {
                "url": "https://go.dev/dl/go1.22.1.linux-amd64.tar.gz",
                "extractFolder": "go",
                "compile_cmd": [
                    "/opt/go/bin/go",
                    "build",
                    "-buildvcs=false",
                    "-o",
                    "main",
                    "{files}"
                ],
                "run_cmd": ["./main"],
                "env": {
                    "GOROOT": "/opt/go",
                    "GOPATH": "/box/go",
                    "GOCACHE": "/box/.cache",
                    "GOTMPDIR": "/box",
                    "GOMAXPROCS": "1",
                    "CGO_ENABLED": "0"
                }
            }
        }
    },
    "rust": {
        "name": "Rust",
        "default_version": "1.76.0",
        "versions": {
            "1.76.0": {
                "url": "https://static.rust-lang.org/dist/rust-1.76.0-x86_64-unknown-linux-gnu.tar.gz",
                "setup_cmd": "cd rust-1.76.0-x86_64-unknown-linux-gnu && ./install.sh --prefix=../rust_env --without=rust-docs",
                "extractFolder": "rust_env",
                "compile_cmd": ["/opt/rust/bin/rustc", "-O", "{files}", "-o", "main"],
                "run_cmd": ["./main"]
            }
        }
    },
    "java": {
        "name": "Java (OpenJDK)",
        "default_version": "21.0.2",
        "versions": {
            "21.0.2": {
                "url": "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.2%2B13/OpenJDK21U-jdk_x64_linux_hotspot_21.0.2_13.tar.gz",
                "extractFolder": "jdk-21.0.2+13",
                "compile_cmd": ["/opt/java/bin/javac", "{files}"],
                "run_cmd": ["/opt/java/bin/java", "Main"]
            }
        }
    },
    "typescript": {
        "name": "TypeScript (Deno)",
        "default_version": "1.41.3",
        "versions": {
            "1.41.3": {
                "url": "https://github.com/denoland/deno/releases/download/v1.41.3/deno-x86_64-unknown-linux-gnu.zip",
                "sha256": "f5ddf3f455b24d5a4446b6b6a8d6a2c240bf67d0a2946566109e26c053d9944e",
                "extractFolder": "deno",
                "compile_cmd": null,
                "run_cmd": [
                    "/opt/typescript/deno",
                    "run",
                    "--quiet",
                    "--check",
                    "--allow-all",
                    "{files}"
                ]
            }
        }
    },
    "bash": {
        "name": "Bash Script",
        "default_version": "system",
        "versions": {
            "system": {
                "url": "system",
                "compile_cmd": null,
                "run_cmd": ["/bin/bash", "{files}"]
            }
        }
    },
    "ruby": {
        "name": "Ruby",
        "default_version": "3.3.0",
        "versions": {
            "3.3.0": {
                "url": "https://github.com/bazel-contrib/portable-ruby/releases/download/3.3.0-1/ruby-3.3.0.x86_64_linux.tar.gz",
                "sha256": "43e305a469b569e8fd45244f915f3a0580115d10c1bf025b928c6a03040578da",
                "strip_components": 1,
                "extractFolder": ".",
                "compile_cmd": null,
                "run_cmd": ["/opt/ruby/bin/ruby", "{files}"]
            }
        }
    }
}
