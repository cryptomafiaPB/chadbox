# ==============================================================================
# CHADBOX CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================
# All variables are optional and have production-tested defaults.
# Copy this file to `.env` or set these in your docker-compose.yml / orchestrator.

# ------------------------------------------------------------------------------
# 1. CONCURRENCY POOL & BACKPRESSURE
# ------------------------------------------------------------------------------

# Soft baseline for active concurrent sandboxes before memory capacity checks engage.
# Default: 5
CHADBOX_SAFE_BASELINE=5

# Maximum number of pending requests waiting in the memory queue.
# When exceeded, incoming requests are rejected immediately with HTTP 429 (Too Many Requests).
# Default: 50
CHADBOX_MAX_QUEUE_DEPTH=50

# Minimum free host RAM (in MB) required to spawn new sandboxes.
# If free memory drops below this threshold, requests above the safe baseline wait in queue.
# Default: 100
CHADBOX_PANIC_MEMORY_MB=100

# Range of isolate box IDs allocated for sandboxes.
# Default: min=1, max=1000
CHADBOX_BOX_POOL_MIN=1
CHADBOX_BOX_POOL_MAX=1000

# Cache duration (in ms) for os.freemem() polling to prevent event-loop throttling.
# Default: 500
CHADBOX_MEM_POLL_INTERVAL_MS=500

# ------------------------------------------------------------------------------
# 2. MOUNTS & VFS CACHE
# ------------------------------------------------------------------------------

# Maximum number of SquashFS runtime bundles mounted simultaneously in the LRU VFS cache.
# Oldest unreferenced mounts are automatically unmounted when capacity is reached.
# Default: 10
CHADBOX_MAX_MOUNTS=10

# Idle time (in ms) before an unreferenced mounted language is eligible for sweeper eviction.
# Default: 900000 (15 minutes)
CHADBOX_IDLE_TIMEOUT_MS=900000

# Frequency (in ms) at which the background TTL sweeper sweeps and unmounts idle runtimes.
# Default: 300000 (5 minutes)
CHADBOX_SWEEPER_INTERVAL_MS=300000

# Directory where installed SquashFS bundles (.sqsh) and metadata manifests (.json) live.
# Default: /app/languages
CHADBOX_STORAGE_DIR=/app/languages

# Directory where SquashFS bundles are loop-mounted for sandbox consumption.
# Default: /app/languages/mounts
CHADBOX_MOUNTS_DIR=/app/languages/mounts

# ------------------------------------------------------------------------------
# 3. ACCESS CONTROL (RUNTIME WHITELIST / BLACKLIST)
# ------------------------------------------------------------------------------

# Comma-separated list of allowed language identifiers.
# If omitted or empty, all installed languages in the storage directory are allowed.
# Example: CHADBOX_ALLOWED_LANGUAGES=python3,nodejs,rust
# Default: (all allowed)
# CHADBOX_ALLOWED_LANGUAGES=

# Comma-separated list of explicitly disabled language identifiers.
# Even if installed, execution requests for these languages will be rejected with HTTP 403.
# Example: CHADBOX_DISABLED_LANGUAGES=bash,ruby
# Default: (none disabled)
# CHADBOX_DISABLED_LANGUAGES=

# ------------------------------------------------------------------------------
# 4. EXECUTION CEILINGS (OPERATOR CONSTRAINTS)
# ------------------------------------------------------------------------------

# Fallback and maximum timeouts for the compilation stage (in milliseconds).
# Default: default=10000 (10s), max=13000 (13s)
CHADBOX_DEFAULT_COMPILE_TIMEOUT_MS=10000
CHADBOX_MAX_COMPILE_TIMEOUT_MS=13000

# Fallback and maximum timeouts for the execution stage (in milliseconds).
# Default: default=3000 (3s), max=10000 (10s)
CHADBOX_DEFAULT_RUN_TIMEOUT_MS=3000
CHADBOX_MAX_RUN_TIMEOUT_MS=10000

# Fallback and maximum RAM limits for compilation (in KB).
# Default: default=512000 (512MB), max=1024000 (1GB)
CHADBOX_DEFAULT_COMPILE_MEMORY_KB=512000
CHADBOX_MAX_COMPILE_MEMORY_KB=1024000

# Fallback and maximum RAM limits for execution (in KB).
# Default: default=128000 (128MB), max=512000 (512MB)
CHADBOX_DEFAULT_RUN_MEMORY_KB=128000
CHADBOX_MAX_RUN_MEMORY_KB=512000

# ------------------------------------------------------------------------------
# 5. SANDBOX HARD LIMITS (KERNEL & PROCESS CONSTRAINTS)
# ------------------------------------------------------------------------------

# Maximum processes/threads allowed during compilation stage (allows AST builders/parallel linkers).
# Default: 256
CHADBOX_MAX_PROCESSES_COMPILE=256

# Maximum processes/threads allowed during execution stage (prevents fork bombs).
# Default: 64
CHADBOX_MAX_PROCESSES_RUN=64

# Maximum file size created in KB during compilation stage (50 MB).
# Default: 51200
CHADBOX_MAX_FSIZE_COMPILE_KB=51200

# Maximum file size created in KB during execution stage (10 MB).
# Default: 10240
CHADBOX_MAX_FSIZE_RUN_KB=10240

# Maximum stdout and stderr output buffer size in bytes before truncation (64 KB).
# Default: 65535
CHADBOX_MAX_OUTPUT_BYTES=65535

